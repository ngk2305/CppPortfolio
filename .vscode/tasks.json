{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (Debug)",
      "type": "shell",
      "command": "cmake -S . -B build/debug -G Ninja -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": []
    },
    {
      "label": "cmake: build current file (Debug)",
      "type": "shell",
      "command": "cmake --build build/debug --target ${fileDirnameBasename}_${fileBasenameNoExtension}",
      "dependsOn": "cmake: configure (Debug)",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cmake: build all (Release)",
      "type": "shell",
      "command": "cmake -S . -B build/release -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build/release",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
