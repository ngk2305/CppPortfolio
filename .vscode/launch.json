{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/${fileDirnameBasename}_${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "preLaunchTask": "cmake: build current file (Debug)",
      "setupCommands": [
        { "description": "Pretty-print STL containers", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
