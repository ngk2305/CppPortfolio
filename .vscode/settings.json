{
  "cmake.generator": "Ninja",
  "cmake.buildDirectory": "${workspaceFolder}/build/cmake-tools",
  "cmake.configureOnOpen": true,
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
  "C_Cpp.default.includePath": ["${workspaceFolder}/common"],
  "files.associations": { "*.hpp": "cpp" }
}
